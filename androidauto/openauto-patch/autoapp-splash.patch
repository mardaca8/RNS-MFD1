     mainWindow.setFixedSize(width, height);
     mainWindow.adjustSize();
 
+    // RNS-MFD1: no openauto menu on the MFD. A black cover (or /etc/openauto/splash.png) inside
+    // the main window hides it, also between sessions. It is a child widget on purpose: the main
+    // window must stay shown, a hidden or covering top-level window leaves the video black.
+    // Keys still reach InputDevice, which filters on the QApplication.
+    QLabel* splash = new QLabel(&mainWindow);
+    splash->setStyleSheet("background-color: black;");
+    splash->setAlignment(Qt::AlignCenter);
+    QPixmap splashImage("/etc/openauto/splash.png");
+    if (!splashImage.isNull()) {
+        splash->setPixmap(splashImage.scaled(width, height, Qt::KeepAspectRatio, Qt::SmoothTransformation));
+    }
+    splash->setGeometry(0, 0, width, height);
+    splash->raise();
+    splash->show();
+
