[Unit]
Description=RNS-MFD1 buttons -> Android Auto (openauto)
Wants=sys-subsystem-net-devices-can0.device
After=sys-subsystem-net-devices-can0.device systemd-networkd.service
# The virtual keyboard must exist before openauto starts reading input devices
Before=openauto.service

[Service]
Type=simple
WorkingDirectory=/opt/rnsaa
ExecStart=/usr/bin/python3 -m rnsaa -c /etc/rnsaa.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
