[Unit]
Description=RNS-MFD1 buttons -> Android Auto (openauto)
# No wait for the can0 device: without a CAN module systemd would block for 90 s, and openauto
# starts after this unit. rnsaa retries can0 itself every 5 s.
After=systemd-networkd.service
# The virtual keyboard must exist before openauto starts reading input devices
Before=openauto.service

[Service]
Type=simple
WorkingDirectory=/opt/rnsaa
ExecStart=/usr/bin/python3 -m rnsaa -c /etc/rnsaa.conf
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
